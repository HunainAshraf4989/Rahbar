{
  "title": "TextRagContracts",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "question",
        "revision"
      ],
      "title": "TextQuestion",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "answered",
            "refused",
            "clarification"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "sentences": {
          "items": {
            "$ref": "#/$defs/Sentence"
          },
          "title": "Sentences",
          "type": "array"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "outcome",
        "text",
        "revision"
      ],
      "title": "TurnAnswer",
      "type": "object"
    }
  ],
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "passage_id": {
          "title": "Passage Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Sentence": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "text",
        "citations"
      ],
      "title": "Sentence",
      "type": "object"
    }
  }
}
